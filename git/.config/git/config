[include]
  path = personal

[includeIf "gitdir:~/work/"]
  path = work

[user]
  useConfigOnly = true

[core]
  editor = nvim
  pager = delta

[fetch]
  prune = true

[pull]
  ff = only

[merge]
  conflictstyle = zdiff3

[diff]
  algorithm = histogram
  colorMoved = default

[interactive]
  diffFilter = delta --color-only

[delta]
  # use n and N to move between diff sections
  navigate = true
  hyperlinks = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true
